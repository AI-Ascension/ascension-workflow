{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.example/contracts/workflow-context-binding-catalog-v1.schema.json",
  "title": "Workflow context binding catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_bindings"],
  "properties": {
    "schema_version": {"const": "ascension.workflow-context-binding-catalog/v1"},
    "context_bindings": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ref", "node_kinds"],
      "properties": {
        "context_ref": {"$ref": "#/$defs/identifier"},
        "node_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["analyze", "decide"]}
        }
      }
    }
  }
}

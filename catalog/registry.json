    "sts2.setup.decision.v1",
    "sts2.combat.decision.v1",
    "sts2.map.decision.v1",
    "sts2.reward.decision.v1",
    "sts2.shop.decision.v1",
    "sts2.event.decision.v1",
    "sts2.rest.decision.v1",
    "sts2.selection.decision.v1"
  ],
  "contexts": [
    "sts2.campaign.context.v1",
    "sts2.setup.context.v1",
    "sts2.combat.context.v1",
    "sts2.map.context.v1",
    "sts2.reward.context.v1",
    "sts2.shop.context.v1",
    "sts2.event.context.v1",
    "sts2.rest.context.v1",
    "sts2.selection.context.v1",
